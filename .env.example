# Compatibility template for legacy compose.yaml.
# New production deployments should use .env.production.example instead.
DOMAIN=qso.example.com

ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# REQUIRED by the hardened production compatibility stack.
# Use exact trusted IPs or IPv4 CIDRs; prefer VPN/Tailscale addresses.
# Example: 100.64.12.34,192.0.2.0/24
ADMIN_ALLOWED_IPS=100.64.12.34

EMBED_FRAME_ANCESTORS='self' https://qrz.com https://*.qrz.com
ALLOW_INSECURE_WAVELOG=false
ALLOW_PRIVATE_WAVELOG=false
