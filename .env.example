# Public DNS name pointing to this Docker host.
DOMAIN=qso.example.com

# Admin credentials. Use a unique password of at least 16 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Used to encrypt the Wavelog API token at rest. Use at least 32 random characters.
CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional: restrict /admin and /api/admin to exact IPs or IPv4 CIDRs.
# Example: 100.64.12.34,192.0.2.0/24
ADMIN_ALLOWED_IPS=

# By default the public iframe is only allowed on the same site and QRZ.
EMBED_FRAME_ANCESTORS='self' https://qrz.com https://*.qrz.com

# Safer defaults. Only enable when your Wavelog is intentionally on HTTP/private LAN.
ALLOW_INSECURE_WAVELOG=false
ALLOW_PRIVATE_WAVELOG=false
