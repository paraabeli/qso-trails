# Copy to .env.production and replace every placeholder before deployment.
DOMAIN=qso.example.com
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-unique-random-password-at-least-20-chars
CONFIG_ENCRYPTION_KEY=replace-with-a-separate-random-key-at-least-32-chars

# REQUIRED by compose.prod.yaml. Allow only your VPN/Tailscale/admin source
# addresses. Multiple entries are comma-separated exact IPs or IPv4 CIDRs.
# Example: 100.64.12.34,192.0.2.0/24
ADMIN_ALLOWED_IPS=100.64.12.34

EMBED_FRAME_ANCESTORS='self' https://qrz.com https://*.qrz.com
ALLOW_INSECURE_WAVELOG=false
ALLOW_PRIVATE_WAVELOG=false
