# Copy to .env.external-edge and replace every secret placeholder before deployment.
DOMAIN=qso.example.com
EDGE_NETWORK=edge-web
QSO_DATA_VOLUME=qso-trails-data

ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-unique-random-password-at-least-20-chars
CONFIG_ENCRYPTION_KEY=replace-with-a-separate-random-key-at-least-32-chars

# External-edge mode intentionally makes admin access loopback-only through the
# private Caddy listener and an SSH tunnel. compose.external-edge.yaml enforces
# this value even if this file is edited later.
ADMIN_ALLOWED_IPS=127.0.0.1

# Permit only the site(s) that should embed /embed.
EMBED_FRAME_ANCESTORS='self' https://example.com

ALLOW_INSECURE_WAVELOG=false
ALLOW_PRIVATE_WAVELOG=false
